; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.

#define MyAppName "369C/C++开发"
#define MyAppVersion "1.0"
#define MyAppPublisher "369工作室"
#define MyAppURL "无"
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{C0136CE7-FF0C-494C-87EA-53B3B0B39ACF}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\369C C++
DefaultGroupName={#MyAppName}
LicenseFile=E:\cc++\LICENSE.txt
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputDir=E:\c c++安装板
OutputBaseFilename=C_CPP_Setup
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"
Name: "chinesetraditional"; MessagesFile: "compiler:Languages\ChineseTraditional.isl"

[Files]
Source: "E:\cc++\7z.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\cc++\7z.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\cc++\hello_cpp.cpp"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\cc++\hollo_c.c"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\cc++\test.cpp"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\cc++\w64devkit.7z"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\cc++\启动环境.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\cc++\一键编译.bat"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files.

[Icons]
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
[Run]
Filename: "{app}\7z.exe"; Parameters: "x w64devkit.7z -y"; WorkingDir: "{app}"; Flags: runhidden
Filename: "{app}\启动环境.bat"; Flags: postinstall nowait skipifsilent
[UninstallDelete]
Type: filesandordirs; Name: "{app}\*"

